{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true
	},
	"include": ["src", "test", "*"],
	"exclude": ["src/service-worker"]
	// SvelteKit 3 は svelte-kit sync で node_modules/$app/tsconfig.json を生成する。
	// src/lib は package.json の imports（#lib）で参照する（SvelteKit 3 で $lib は廃止）
}
